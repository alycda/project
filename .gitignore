# ============================================================
# Agent plugins (curated)
# ============================================================
# Patterns for third-party agent plugins that aren't in
# github/gitignore's Agents.gitignore upstream. Each plugin notes
# its source URL inline. Update by hand when plugins drift.

# Understand-Anything (https://github.com/Lum1104/Understand-Anything)
.understand-anything/intermediate/
.understand-anything/tmp/
.understand-anything/*.json
!.understand-anything/.understandignore


# ============================================================
# Shell
# ============================================================
# Curated. No upstream. Add shell-specific ignores here.

# dotenv environment variable files
.env
.env.*
!.env.example

