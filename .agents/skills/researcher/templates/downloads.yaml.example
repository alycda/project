# _docs/research/downloads.yaml
# Idempotent-upsert format. The `url` field is the unique key.
# Each entry tracks a source's download state across re-runs.
#
# Step 2 produces this file (upsert: new URLs added as `pending`,
#   existing entries' status/path/notes preserved).
# Step 3 updates `status`, `path`, `accessed`, and `archived` as downloads complete.
# Step 4 reads `license` and `flags` when emitting SOURCES.md records.
#
# This file is TRACKED. It is the capture record — the thing SOURCE-POLICY.md
# says belongs in history, as opposed to the captured material itself, which
# lands in _inspiration/ and stays there.
#
# ---------------------------------------------------------------------------
# Provenance fields (license / accessed / archived / flags / sha256)
# ---------------------------------------------------------------------------
# Captured at manifest time because that is the only cheap moment. Recovering
# a license for 200 URLs a week later means reopening 200 tabs; recording it
# while the URL is already in hand costs one field.
#
#   license   SPDX identifier — CC-BY-4.0, CC-BY-SA-4.0, CC-BY-NC-4.0, CC0-1.0,
#             MIT, Apache-2.0, GPL-3.0-or-later, ...
#             Two non-SPDX values are allowed and both mean "do not commit the
#             full text": LicenseRef-all-rights-reserved and LicenseRef-unknown.
#             Unknown is an honest answer and is handled as all-rights-reserved.
#             Check the site's ToS for a GRANT before defaulting — Stack
#             Exchange answers are CC-BY-SA-4.0, not all-rights-reserved.
#   accessed  ISO 8601 date the source was actually fetched.
#   archived  Wayback/archive.today snapshot URL, or
#             `none  # save failed YYYY-MM-DD, <reason>`. Never omit the field.
#   flags     [] or any of: noncommercial-only (BY-NC), sharealike-integrated
#             (BY-SA text woven into your own prose), status-unverified
#             (license recorded but not confirmed at the source).
#             Exists so the pre-publication sweep is `rg noncommercial-only`
#             rather than a re-read of every entry.
#   sha256    Digest of the downloaded file. Required for load-bearing sources.
#             Proves your copy is unchanged since you hashed it; the archive
#             snapshot is what carries third-party timestamp evidence.

version: 2

entries:
  # A successfully-downloaded paper, open-licensed — safe to quote at length
  - url: https://arxiv.org/abs/2406.12345
    kind: paper
    title: "Some CRDT Paper"
    cited_in: [claude, claude-deep-research]
    status: done       # pending | downloading | done | failed | skipped
    path: _inspiration/papers/2406.12345.pdf
    license: CC-BY-4.0
    accessed: 2026-08-06
    archived: https://web.archive.org/web/20260806120000/https://arxiv.org/abs/2406.12345
    flags: []
    sha256: 3b1f9c...
    notes: "Foundational; see section 4.2"

  # A repo waiting to be downloaded. Copyleft — flagged before it is cloned,
  # because vendoring it later is the decision that actually costs something.
  - url: https://github.com/owner/repo
    kind: repo
    title: "Reference Implementation"
    cited_in: [codex, gemini-deep-research]
    status: pending
    path: null
    license: AGPL-3.0-or-later
    accessed: null
    archived: null
    flags: [sharealike-integrated]
    notes: "AGPL — fine to read and cite. If any of it gets vendored it goes to
      third_party/ with its LICENSE intact, and § 13's network clause applies
      to anything we expose as a service."

  # All-rights-reserved article: record + excerpt only, never the full text
  - url: https://example.com/blog/postmortem
    kind: article
    title: "ABI Breakage Postmortem"
    cited_in: [claude]
    status: done
    path: _inspiration/articles/example-com-blog-postmortem/
    license: LicenseRef-all-rights-reserved
    accessed: 2026-08-06
    archived: https://web.archive.org/web/20260806120500/https://example.com/blog/postmortem
    flags: []
    notes: "Local copy only. SOURCES.md carries the citation + two excerpts."

  # A failed download — the archive snapshot is what survives
  - url: https://example.com/blog/gone
    kind: article
    title: "Deleted Postmortem"
    cited_in: [gemini]
    status: failed
    path: null
    license: LicenseRef-unknown
    accessed: 2026-08-06
    archived: https://web.archive.org/web/20240101000000/https://example.com/blog/gone
    flags: [status-unverified]
    notes: "404 at origin; cite the snapshot. License never determinable — the
      page is gone, so it stays LicenseRef-unknown."

  # A paywalled / auth-gated source skipped on purpose
  - url: https://docs.example.com/sdk/
    kind: docs
    title: "SDK Documentation"
    cited_in: [gemini-deep-research]
    status: skipped
    path: null
    license: LicenseRef-all-rights-reserved
    accessed: null
    archived: null
    flags: []
    notes: "Auth-gated. 401 is the system working — do not add credential
      handling to defeat it. Cite without the copy."

  # A repo too large to clone under default size cap
  - url: https://github.com/giant/monorepo
    kind: repo
    title: "Giant Monorepo"
    cited_in: [theory]
    status: skipped
    path: null
    license: Apache-2.0
    accessed: null
    archived: null
    flags: []
    notes: "Size > max_size_mb; clone manually if needed"
