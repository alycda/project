# ============================================================
# Project-specific (language, build tools, dependencies)
# ============================================================
# Most-volatile section. Add language and tooling ignores here.
# No upstream — curated per project.

# --- Nix (from alycda/project initial template) ---
# Ignore build outputs from `nix build` / `nix-build`
result
result-*

# Ignore automatically generated direnv output
.direnv

# Ignore NixOS interactive test driver history
**/.nixos-test-history


